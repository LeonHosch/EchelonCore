{
  "schemaVersion": 1,
  "id": "echelon-core",
  "version": "${version}",
  "name": "Echelon Core",
  "description": "Echelon gameplay systems built on Crazy World Progression.",
  "authors": ["Leon Hosch"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["ekuzo.echeloncore.EchelonCore"],
    "client": ["ekuzo.echeloncore.client.EchelonCoreClient"]
  },
  "mixins": [
    "echelon-core.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "geckolib": ">=5.5.5",
    "crazy-world-progression": ">=0.6.0"
  },
  "custom": {
    "crazy-world-progression": {
      "requires_modules": ["mobforge", "world_boundary", "currency", "collectibles", "fletching", "reforge",
        "equipment", "skill_trees", "random_events", "divine_protection", "accessories"]
    }
  }
}
